# Copy this file to .env and fill in real values. The .env file is gitignored.
# docker compose loads .env automatically.

# Azure OpenAI — resource endpoint (bare host, no path), key, and chat deployment name
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=<your-deployment-name>

# GCP OAuth (only needed for GCP assessments)
GCP_OAUTH_CLIENT_ID=
GCP_OAUTH_CLIENT_SECRET=
GCP_OAUTH_REDIRECT_URI=http://localhost:8000/gcp-oauth-callback

# Assessment output and coverage (all optional - defaults shown)
# Workbooks are written to the project's data/ folder (mounted in Docker, so they survive rebuilds)
# ASSESSMENT_OUTPUT_DIR=/app/data
# Secret values (keys, tokens, passwords, connection strings) are always masked; usernames too unless false
# MASK_USERNAMES=true
# Extra data collected outside Resource Graph's Resources table
# ENABLE_DIAGNOSTIC_SETTINGS=true
# MAX_DIAGNOSTIC_RESOURCES=1500
# DIAGNOSTIC_WORKERS=8
# ENABLE_POLICY=true
# ENABLE_LOCKS=true
# ENABLE_DEFENDER=true
# ENABLE_BACKUP=true
